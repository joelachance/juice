# Juice API server configuration. Copy to .env and fill in.
#   cp .env.example .env && chmod 600 .env
#
# The server reads this at startup (override the path with JUICE_ENV_FILE).
# The real environment always wins over this file, so a stale copy can never
# override what a deploy set explicitly.
#
# The CLI and SDK deliberately ignore this file — a .env in a repository must
# not be able to redirect which scope or store your secrets go to.

# Signs session tokens. >=32 chars, no fallback. Changing it logs everyone out.
#   openssl rand -base64 32
JUICE_TOKEN_SECRET=

# Membership store. The HTTP Actions URL (.convex.site), not .convex.cloud.
JUICE_CONVEX_URL=https://your-deployment.convex.site

# Must equal JUICE_API_SHARED_SECRET in that Convex deployment.
#   npx convex env get JUICE_API_SHARED_SECRET
JUICE_CONVEX_SECRET=

# GitHub app Client ID (Iv23li…), not the App ID. Device flow must be enabled.
GITHUB_CLIENT_ID=

# Optional
# PORT=8787
# HOST=127.0.0.1
