{
  "name": "@juice/sdk",
  "version": "0.1.0",
  "description": "Agent secrets without copy/paste: an explicit-scope CLI and SDK backed by a local store or AWS Secrets Manager.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "juice": "./dist/src/cli/main.js"
  },
  "exports": {
    ".": "./dist/src/sdk/index.js"
  },
  "files": [
    "dist/src/sdk",
    "dist/src/cli",
    "dist/src/auth",
    "dist/src/config",
    "dist/src/http",
    "dist/src/local",
    "LICENSE",
    "LICENSING.md",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "npm run build && node scripts/run-api-local.mjs",
    "cli": "npm run build && node dist/src/cli/main.js",
    "link": "npm run build && npm link",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm test && npm run check:licenses && npm run check:pack",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "test:api-local": "npm run build && node scripts/test-api-local.mjs",
    "start:api": "node dist/src/api/main.js",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:env": "convex env list",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "cdk:deploy": "cdk deploy"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.840.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "aws-cdk": "^2.1143.0",
    "aws-cdk-lib": "^2.261.0",
    "constructs": "^10.6.0",
    "convex": "^1.17.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
